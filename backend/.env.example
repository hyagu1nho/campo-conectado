# Copie para .env e ajuste se o seu banco usar outro usuario, senha ou porta.
# Os valores abaixo batem com o docker-compose.yml da raiz (so desenvolvimento).
DATABASE_URL="postgresql://app:app@localhost:5432/appdb?schema=public"

# Segredo de assinatura do JWT. Gere um valor proprio, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="troque-este-valor"

# Origens aceitas pelo navegador, separadas por vírgula: o cliente web (3001)
# e o app Flutter rodando no navegador em desenvolvimento (3002).
CORS_ORIGIN="http://localhost:3001,http://localhost:3002"
